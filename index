<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0b0f" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)">
<title>Максим Витков — цифровая визитка</title>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<style>
  :root {
    --bg: #f5f5f7;
    --card: #ffffff;
    --text: #1c1c1e;
    --text2: #6e6e73;
    --border: #e3e3e8;
    --accent: #007aff;
    --btn-bg: #f2f2f5;
    --btn-hover: #e9e9ee;
    --shadow: 0 2px 16px rgba(0,0,0,.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b0b0f;
      --card: #17171c;
      --text: #f2f2f5;
      --text2: #98989f;
      --border: #2a2a31;
      --accent: #0a84ff;
      --btn-bg: #222228;
      --btn-hover: #2c2c33;
      --shadow: 0 2px 16px rgba(0,0,0,.35);
    }
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 24px 16px;
  }
  .card {
    width: 100%;
    max-width: 420px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 28px 22px;
    height: fit-content;
  }
  .avatar {
    width: 84px; height: 84px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 32px; font-weight: 600;
    margin: 0 auto 14px;
  }
  h1 { font-size: 24px; text-align: center; font-weight: 700; }
  .subtitle { text-align: center; color: var(--text2); font-size: 14px; margin: 6px 0 24px; }

  .btn {
    display: flex; align-items: center; gap: 14px;
    width: 100%;
    padding: 14px 16px;
    margin-bottom: 10px;
    background: var(--btn-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text);
    font-size: 16px;
    text-decoration: none;
    cursor: pointer;
    transition: background .15s ease;
    font-family: inherit;
    text-align: left;
  }
  .btn:hover { background: var(--btn-hover); }
  .btn:active { transform: scale(.985); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .btn.primary:hover { filter: brightness(1.08); }
  .btn .icon {
    width: 38px; height: 38px; flex: 0 0 38px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.18);
  }
  .btn.primary .icon { background: rgba(255,255,255,.22); }
  .btn .icon svg { width: 20px; height: 20px; fill: currentColor; }
  .btn small { display: block; color: var(--text2); font-size: 12px; margin-top: 2px; }
  .btn.primary small { color: rgba(255,255,255,.75); }

  .section-title {
    font-size: 12px; text-transform: uppercase; letter-spacing: .08em;
    color: var(--text2); margin: 22px 4px 10px;
  }

  .qr-wrap {
    display: flex; flex-direction: column; align-items: center;
    margin-top: 26px; padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .qr-wrap p { font-size: 13px; color: var(--text2); margin-bottom: 12px; text-align: center; }
  #qrcode { background: #fff; padding: 10px; border-radius: 12px; line-height: 0; }
  #qrcode img, #qrcode canvas { border-radius: 4px; }

  .toast {
    position: fixed; left: 50%; bottom: 24px;
    transform: translateX(-50%) translateY(80px);
    background: var(--text); color: var(--bg);
    padding: 10px 18px; border-radius: 12px;
    font-size: 14px; opacity: 0;
    transition: all .25s ease; pointer-events: none;
    max-width: 90vw; text-align: center;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div class="card">
  <div class="avatar">МВ</div>
  <h1>Максим Витков</h1>
  <p class="subtitle">Цифровая визитка · NFC-карта</p>

  <button class="btn primary" onclick="downloadVCard()">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 12c4.42 0 8 2.24 8 5v3H4v-3c0-2.76 3.58-5 8-5Z"/></svg></span>
    <span>Добавить в контакты<small>Имя, фамилия, телефон, почта</small></span>
  </button>

  <div class="section-title">Связаться</div>

  <a class="btn" href="tel:+37378407287">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02Z"/></svg></span>
    <span>Позвонить<small>+373 78 407 287</small></span>
  </a>

  <a class="btn" href="mailto:vitm36844@gmail.com">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2 2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5Z"/></svg></span>
    <span>Написать на почту<small>vitm36844@gmail.com</small></span>
  </a>

  <a class="btn" href="https://t.me/Vitk0V" target="_blank" rel="noopener">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M21.9 4.6 18.8 19c-.2 1-.8 1.2-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.3-4.6L18 6.9c.4-.3-.1-.5-.6-.2L7.2 13.2 2.7 11.8c-1-.3-1-1 .2-1.4l18-7c.8-.3 1.5.2 1 1.2Z"/></svg></span>
    <span>Telegram<small>@Vitk0V</small></span>
  </a>

  <a class="btn" href="https://wa.me/37378407287" target="_blank" rel="noopener">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.7-1.3 1.3-1.9 1.3-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5s.7 1.8.8 1.9c.1.1.1.3 0 .5l-.4.6c-.2.2-.4.4-.2.8.2.4 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.8.4.2.6.1.8-.1l.9-1.1c.2-.3.4-.2.7-.1l1.8.9c.3.1.5.2.5.4 0 0 .1.6-.2 1.3Z"/></svg></span>
    <span>WhatsApp<small>+373 78 407 287</small></span>
  </a>

  <div class="section-title">Деньги</div>

  <a class="btn" href="https://mia-qr.bnm.md/1/m/BNM/AGRbcfca880b0184d258a83a8d54f41d606" target="_blank" rel="noopener">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 2 2 7v2h20V7Zm-10 9v8H2v3h20v-3h-2v-8Zm4 0h4v4H6Zm6 0h4v8h-4ZM4 13v6h2v-6Zm0 0"/></svg></span>
    <span>Перевести деньги<small>mia · на номер +373 78 407 287</small></span>
  </a>

  <div class="section-title">Геолокация</div>

  <button class="btn" onclick="shareFoundLocation()">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg></span>
    <span>📍 Я нашёл эту карту здесь<small>Отправить координаты Максиму на почту</small></span>
  </button>

  <a class="btn" href="https://www.google.com/maps/search/?api=1&query=Strada+Maria+Dr%C4%83gan+22%2F1%2C+Chi%C8%99in%C4%83u" target="_blank" rel="noopener">
    <span class="icon"><svg viewBox="0 0 24 24"><path d="m12 3 9 8h-3v9h-4v-6h-4v6H6v-9H3Z"/></svg></span>
    <span>Дом (вернуть карту)<small>Strada Maria Drăgan 22/1, Chișinău</small></span>
  </a>

  <div class="qr-wrap">
    <p>Поделиться этой визиткой<br>(отсканируйте QR-код)</p>
    <div id="qrcode"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ---------- vCard ----------
  function downloadVCard() {
    const vcf = [
      'BEGIN:VCARD',
      'VERSION:3.0',
      'N:Vitkov;Maxim;;;',
      'FN:Максим Витков',
      'TEL;TYPE=CELL:+37378407287',
      'EMAIL:vitm36844@gmail.com',
      'END:VCARD'
    ].join('\r\n');
    const blob = new Blob([vcf], { type: 'text/vcard;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Maxim-Vitkov.vcf';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    showToast('Файл контакта сохранён — откройте его, чтобы добавить в контакты');
  }

  // ---------- Геолокация: отправка координат на почту ----------
  function shareFoundLocation() {
    if (!navigator.geolocation) {
      showToast('Геолокация не поддерживается на этом устройстве');
      return;
    }
    showToast('Определяем местоположение…');
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const { latitude, longitude, accuracy } = pos.coords;
        const mapsUrl = 'https://www.google.com/maps?q=' + latitude + ',' + longitude;
        const text = 'Вашу NFC-карту отсканировали!\n' +
                     'Координаты: ' + latitude + ', ' + longitude +
                     ' (точность ~' + Math.round(accuracy) + ' м)\n' +
                     'На карте: ' + mapsUrl + '\n' +
                     'Время: ' + new Date().toLocaleString();
        try {
          const res = await fetch('https://formsubmit.co/ajax/vitm36844@gmail.com', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              _subject: '📍 NFC-карта найдена!',
              _template: 'table',
              _captcha: 'false',
              message: text
            })
          });
          if (!res.ok) throw new Error();
          showToast('✅ Отправлено! Максим получил местоположение');
        } catch (e) {
          // Если отправка не сработала — предлагаем поделиться вручную
          if (navigator.share) {
            navigator.share({ title: 'Карта найдена здесь', text: 'Отправьте это Максиму:', url: mapsUrl }).catch(() => {});
          } else {
            window.open(mapsUrl, '_blank');
          }
        }
      },
      () => showToast('Не удалось получить геолокацию — проверьте разрешения'),
      { enableHighAccuracy: true, timeout: 10000 }
    );
  }

  // ---------- Toast ----------
  let toastTimer;
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3500);
  }

  // ---------- QR-код ----------
  new QRCode(document.getElementById('qrcode'), {
    text: location.href,
    width: 160,
    height: 160,
    correctLevel: QRCode.CorrectLevel.M
  });
</script>

</body>
</html>
